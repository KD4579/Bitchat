// Campaign templates generated by tools/email-templates/gen_campaigns.py
$mc_dir       = 'assets/email-campaigns/';
$mc_templates = array();
if (is_file($mc_dir . 'manifest.json')) {
    foreach ((array) json_decode(file_get_contents($mc_dir . 'manifest.json'), true) as $t) {
        $key = preg_replace('/[^a-z0-9_]/', '', $t['key']);
        if ($key && is_file($mc_dir . $key . '.html')) {
            $t['html'] = file_get_contents($mc_dir . $key . '.html');
            $mc_templates[] = $t;
        }
    }
}
$mc_audiences = function_exists('Wo_McAudiences') ? Wo_McAudiences() : array();
$mc_ready     = function_exists('Wo_McTablesReady') && Wo_McTablesReady();
$mc_json_opts = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE;
?>
