<script>
(function () {
    var templates = <?php echo json_encode($mc_templates, $mc_json_opts); ?>;
    var ajaxUrl   = Wo_Ajax_Requests_File();
    var $form = $('#mc_form'), $html = $('#mc_html'), lastFocus = $html[0];
    var selected = {};

    function alertBox(type, msg) {
        $('#mc_alert').html('<div class="alert alert-' + type + '">' + msg + '</div>');
        $('html, body').animate({ scrollTop: $('#mc_alert').offset().top - 90 }, 300);
    }
    function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
    function post(action, extra) {
        var data = $form.serializeArray();
        (extra || []).forEach(function (x) { data.push(x); });
        return $.ajax({ url: ajaxUrl + '?f=admin_setting&s=' + action, type: 'POST', data: $.param(data), dataType: 'json' });
    }

    // ---------- templates
    var $tpl = $('#mc_templates');
    templates.forEach(function (t, i) {
        $tpl.append('<div class="mc-tpl" data-i="' + i + '"><div class="ic">' + esc(t.icon) + '</div><div class="nm">' + esc(t.name) +
            '</div><div class="ds">' + esc(t.description) + '</div></div>');
    });
    function useTemplate(i, force) {
        var t = templates[i];
        if (!t) return;
        if (!force && $html.val().trim() !== '' && !confirm('Replace the current message with the "' + t.name + '" template?')) return;
        $('.mc-tpl').removeClass('active').filter('[data-i="' + i + '"]').addClass('active');
        $('#mc_template').val(t.key);
        $('#mc_subject').val(t.subject);
        $('#mc_preheader').val(t.preheader || '');
        $html.val(t.html);
        if (t.key.indexOf('welcome_back') === 0 && +$('#mc_bonus').val() === 0) { $('#mc_bonus').val(50); }
        refreshPreview(); bonusCost();
    }
    $tpl.on('click', '.mc-tpl', function () { useTemplate(+$(this).data('i'), false); });

    // ---------- tokens
    $('#mc_subject, #mc_preheader, #mc_html').on('focus', function () { lastFocus = this; });
    $('.mc-token').on('click', function () {
        var el = lastFocus, tok = $(this).data('token');
        var a = el.selectionStart || 0, b = el.selectionEnd || 0;
        el.value = el.value.slice(0, a) + tok + el.value.slice(b);
        el.focus(); el.selectionStart = el.selectionEnd = a + tok.length;
        refreshPreview();
    });

    // ---------- preview
    var pTimer = null;
    function refreshPreview() {
        clearTimeout(pTimer);
        pTimer = setTimeout(function () {
            if ($html.val().trim() === '') { $('#mc_frame').attr('srcdoc', ''); return; }
            post('campaign_preview').done(function (d) {
                if (d.status !== 200) return;
                $('#mc_frame').attr('srcdoc', d.html);
                $('#mc_prev_subj').text(d.subject || 'Subject');
                $('#mc_prev_pre').text($('#mc_preheader').val() ? '— ' + $('#mc_preheader').val() : '');
                $('#mc_size').text('Email size: ' + Math.round(d.size / 1024) + ' KB' + (d.size > 95000 ? ' ⚠️ Gmail clips emails over ~100 KB' : ''));
            });
        }, 450);
    }
    $('#mc_subject, #mc_preheader, #mc_html, #mc_bonus, #mc_bonus_until').on('input change', function () {
        refreshPreview();
        var sj = $('#mc_subject').val();
        var warn = /[A-Z]{5,}/.test(sj.replace(/\{\{[A-Z_]+\}\}/g, '')) || /!!|free|100%|\$\$\$|act now|urgent/i.test(sj);
        $('#mc_subject_hint').toggleClass('text-danger', warn).text(warn
            ? '⚠️ This subject may trigger spam filters (caps, "free", "!!", "urgent"…). Try something calmer.'
            : 'Keep it short, personal and calm: no ALL CAPS, no "FREE!!!", one emoji at most.');
    });
    $('[data-view]').on('click', function () {
        $('[data-view]').removeClass('active'); $(this).addClass('active');
        $('#mc_frame_wrap').toggleClass('mobile', $(this).data('view') === 'mobile');
    });

    // ---------- audience
    var lastCount = 0;
    function count() {
        var aud = $('#mc_audience').val();
        $('#mc_selected_box').toggle(aud === 'selected');
        $('#mc_count').html('Counting recipients…');
        post('campaign_count').done(function (d) {
            if (d.status !== 200) { $('#mc_count').html(esc(d.message || 'Could not count recipients')); return; }
            lastCount = d.count;
            var x = d.excluded || {};
            $('#mc_count').html('<b class="big">' + d.count.toLocaleString() + '</b> recipients will get this email.<br>' +
                '<span class="text-muted">Always excluded across all users: throwaway domains ' + (x.disposable || 0).toLocaleString() +
                ' · fake ' + (x.fake || 0) + ' · banned ' + (x.banned || 0) + ' · opted out ' + (x.opted_out || 0) +
                ' · unconfirmed ' + (x.unconfirmed || 0) + ' · bounced/unsubscribed ' + (x.suppressed || 0) + '</span>');
            bonusCost();
        });
    }
    function bonusCost() {
        var b = +$('#mc_bonus').val() || 0;
        $('#mc_bonus_cost').text(b > 0 && lastCount ? 'Maximum cost if everyone returns: ' + (b * lastCount).toLocaleString() + ' TRDC (typically 5–15% come back).' : '');
    }
    $('#mc_audience').on('change', count);
    $('#mc_bonus').on('input', bonusCost);

    // selected users (reuses the existing get_users_emails search)
    var sTimer = null;
    $('#mc_user_search').on('input', function () {
        var name = this.value; clearTimeout(sTimer);
        sTimer = setTimeout(function () {
            if (!name) { $('.search-mailing-users').html(''); return; }
            $.getJSON(ajaxUrl, { f: 'admin_setting', s: 'get_users_emails', name: name }, function (d) {
                $('.search-mailing-users').html(d.status == 200 ? d.html : '');
            });
        }, 300);
    });
    $(document).on('click', '.search-mailing-users p', function () {
        selected[$(this).attr('data-user')] = $(this).text(); renderSelected(); $(this).remove();
    });
    $(document).on('click', '.mc-sel-x', function () { delete selected[$(this).data('id')]; renderSelected(); });
    function renderSelected() {
        var ids = Object.keys(selected);
        $('#mc_selected_ids').val(ids.join(','));
        $('#mc_selected_list').html(ids.map(function (id) {
            return '<span class="badge badge-light mr-1 mb-1" style="font-size:13px;">@' + esc(selected[id]) +
                ' <a href="javascript:;" class="mc-sel-x" data-id="' + id + '">&times;</a></span>';
        }).join(''));
        count();
    }

    // ---------- test + start
    $('#mc_test_btn').on('click', function () {
        var $b = $(this).prop('disabled', true).text('Sending…');
        post('campaign_test').done(function (d) {
            if (d.status !== 200) { alertBox('danger', esc(d.message)); return; }
            var lines = Object.keys(d.results).map(function (e) {
                return (d.results[e] === 'sent' ? '✅ ' : '❌ ') + esc(e) + (d.results[e] === 'sent' ? '' : ' – ' + esc(d.results[e]));
            });
            alertBox('success', '<b>Test sent.</b> Check the inbox (and that it is not in Spam/Promotions):<br>' + lines.join('<br>'));
        }).fail(function () { alertBox('danger', 'Test failed. Please try again.'); })
          .always(function () { $b.prop('disabled', false).html('&#128233; Send test email'); });
    });
    $('#mc_start_btn').on('click', function () {
        var b = +$('#mc_bonus').val() || 0;
        var msg = 'Start this campaign for ' + lastCount.toLocaleString() + ' recipients?\n\n' +
            '• Subject: ' + $('#mc_subject').val() + '\n' +
            (b > 0 ? '• Bonus: ' + b + ' TRDC each, until ' + $('#mc_bonus_until').val() + '\n' : '• No bonus\n') +
            '• Sent gradually under the warm-up limits. You can pause any time.\n\nDid you send yourself a test first?';
        if (!confirm(msg)) return;
        var $b = $(this).prop('disabled', true).text('Starting…');
        post('campaign_create').done(function (d) {
            if (d.status !== 200) { alertBox('danger', esc(d.message)); return; }
            alertBox('success', '<b>Campaign #' + d.id + ' started</b> – ' + d.total.toLocaleString() + ' emails queued. Track progress below.');
            loadCampaigns();
        }).fail(function () { alertBox('danger', 'Could not start the campaign.'); })
          .always(function () { $b.prop('disabled', false).html('&#128640; Start campaign'); });
    });

    // ---------- campaigns panel
    function loadCampaigns() {
        $.getJSON(ajaxUrl + '?f=admin_setting&s=campaign_status', function (d) {
            if (d.status !== 200) { $('#mc_campaigns').html('<div class="text-muted">' + esc(d.message || '') + '</div>'); return; }
            var w = d.warmup;
            $('#mc_from').text(w.from);
            $('#mc_warm').html('&#128293; <b>Warm-up</b> ' + (w.day ? 'day ' + w.day : 'not started yet') +
                ' · today ' + w.sent_today + ' / ' + w.daily_cap + ' · last hour ' + w.sent_hour + ' / ' + w.hour_cap +
                ' · sending window ' + esc(w.window) + '. Limits rise automatically each day while delivery stays healthy.');
            if (!d.campaigns.length) { $('#mc_campaigns').html('<div class="text-muted">No campaigns yet.</div>'); return; }
            $('#mc_campaigns').html(d.campaigns.map(function (c) {
                var s = c.stats, total = +c.total || 1;
                var done = s.sent + s.bounced, pct = Math.min(100, Math.round(done * 100 / total));
                var btns = c.status === 'sending' ? '<button class="btn btn-sm btn-warning mc-act" data-a="pause" data-id="' + c.id + '">Pause</button>'
                    : (c.status === 'paused' ? '<button class="btn btn-sm btn-success mc-act" data-a="resume" data-id="' + c.id + '">Resume</button>' : '');
                if (c.status === 'sending' || c.status === 'paused') btns += ' <button class="btn btn-sm btn-light mc-act" data-a="cancel" data-id="' + c.id + '">Cancel</button>';
                var errs = (s.errors || []).slice(0, 5).map(function (e) { return '<div class="small text-muted">' + esc(e.email) + ': ' + esc(e.error) + '</div>'; }).join('');
                return '<div style="border:1px solid #ece7f6;border-radius:14px;padding:14px 16px;margin-bottom:12px;">' +
                    '<div class="d-flex justify-content-between"><div><b>#' + c.id + ' ' + esc(c.subject) + '</b> <span class="mc-pill ' + esc(c.status) + '">' + esc(c.status) + '</span>' +
                    (c.status_reason ? '<div class="small text-muted">' + esc(c.status_reason) + '</div>' : '') + '</div><div>' + btns + '</div></div>' +
                    '<div class="mc-progress mt-2"><div class="mc-grad" style="width:' + pct + '%"></div></div>' +
                    '<div class="mt-2"><span class="mc-kpi"><b>' + done.toLocaleString() + ' / ' + (+c.total).toLocaleString() + '</b>sent (' + pct + '%)</span>' +
                    '<span class="mc-kpi"><b>' + s.pending.toLocaleString() + '</b>waiting</span>' +
                    '<span class="mc-kpi"><b>' + (s.bounced + s.failed) + '</b>bounced/failed</span>' +
                    '<span class="mc-kpi"><b>' + s.deferred + '</b>delayed</span>' +
                    '<span class="mc-kpi"><b>' + s.returned.toLocaleString() + '</b>came back &#127881;</span>' +
                    (+c.bonus_trdc > 0 ? '<span class="mc-kpi"><b>' + s.bonus_paid.toLocaleString() + '</b>bonuses paid</span>' : '') +
                    '<span class="mc-kpi"><b>' + s.skipped + '</b>skipped</span></div>' + errs + '</div>';
            }).join(''));
        });
    }
    $(document).on('click', '.mc-act', function () {
        var a = $(this).data('a'), id = $(this).data('id');
        if (a === 'cancel' && !confirm('Cancel campaign #' + id + '? Emails not yet sent will be dropped.')) return;
        post('campaign_' + a, [{ name: 'id', value: id }]).done(function (d) {
            if (d.status !== 200) alertBox('danger', esc(d.message)); loadCampaigns();
        });
    });
    $('#mc_refresh').on('click', loadCampaigns);

    // init
    if (templates.length) useTemplate(0, true);
    count();
    loadCampaigns();
    setInterval(loadCampaigns, 60000);
})();
</script>
